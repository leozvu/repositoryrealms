// Agency ERP — schema đơn tenant (1 công ty)
// v3.5+: Postgres (Supabase) cho cả dev lẫn production.
// DATABASE_URL = pooler (6543, pgbouncer) cho runtime · DIRECT_URL = kết nối thẳng (5432) cho db push
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// v2.1: 7 vai trò — DIRECTOR, PM, AM, ACCOUNTANT, HR, LEAD, STAFF.
// Một người giữ được nhiều vai trò (roles = JSON array, cộng quyền).
// Cột `role` cũ giữ lại để tương thích, không dùng nữa.
model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  role         String    @default("STAFF")
  roles        String    @default("[\"STAFF\"]")
  teamId       String?
  title        String? // chức danh: Designer, Account Manager…
  phone        String?
  salary       Int       @default(0) // chỉ DIRECTOR và chính chủ được xem
  status       String    @default("active") // active | inactive
  totpSecret   String? // v3.2: 2FA TOTP — null = chưa bật
  birthday     String? // v3.8: YYYY-MM-DD — AI Summary nhắc sinh nhật
  userType     String    @default("employee") // v3.11: employee | freelancer
  accessUntil  String? // v3.11: YYYY-MM-DD — freelancer hết hạn thì chặn đăng nhập
  hourlyRate   Int       @default(0) // v3.11: đơn giá giờ freelancer (nhân viên dùng lương÷176)
  skills       String? // v3.11: kỹ năng freelancer
  portfolio    String? // v3.11: link portfolio freelancer
  loginFails   Int       @default(0) // v3.13: số lần nhập sai liên tiếp — chống dò mật khẩu
  lockedUntil  DateTime? // v3.13: khóa đăng nhập tạm đến thời điểm này
  createdAt    DateTime  @default(now())
  tasks        Task[]
  timeLogs     TimeLog[]
  leaves       Leave[]
}

// ===== v3.11: Thành viên dự án — gắn freelancer (và nhân sự) vào dự án cụ thể =====
model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  role      String? // vai trò trong dự án: Designer, Editor…
  createdAt DateTime @default(now())

  @@unique([projectId, userId])
}

// ===== v3.11: Ngày lễ công ty — không tính là vắng =====
model Holiday {
  id   String @id @default(cuid())
  date String @unique // YYYY-MM-DD
  name String
}

model Client {
  id        String    @id @default(cuid())
  name      String
  contact   String?
  email     String?
  phone     String?
  industry  String?
  address   String?
  note      String?
  createdAt String? // ISO date
  projects  Project[]
  invoices  Invoice[]
  quotes    Quote[]
  contacts  Contact[]
}

// ===== v3.4: một khách nhiều người liên hệ =====
model Contact {
  id       String  @id @default(cuid())
  clientId String
  client   Client  @relation(fields: [clientId], references: [id])
  name     String
  role     String? // chức vụ: Marketing Manager, Kế toán…
  email    String?
  phone    String?
  primary  Boolean @default(false) // người liên hệ chính
  note     String?
}

model Lead {
  id            String  @id @default(cuid())
  name          String
  company       String?
  email         String?
  phone         String?
  source        String?
  value         Int     @default(0)
  stage         String  @default("new")
  ownerId       String?
  note          String?
  createdAt     String?
  expectedClose String? // v3.4: tháng/ngày dự kiến chốt (YYYY-MM-DD) — cho forecast
}

model Service {
  id    String  @id @default(cuid())
  name  String
  unit  String?
  price Int     @default(0)
  desc  String?
}

model Project {
  id           String      @id @default(cuid())
  name         String
  clientId     String?
  client       Client?     @relation(fields: [clientId], references: [id])
  service      String?
  budget       Int         @default(0)
  status       String      @default("planning")
  startDate    String?
  deadline     String?
  progress     Int         @default(0)
  autoProgress Boolean     @default(true) // v3.10: tiến độ tính tự động từ task
  budgetHours  Int         @default(0) // v3.10: ngân sách giờ công dự án
  tasks        Task[]
  timeLogs     TimeLog[]
  milestones   Milestone[]
  phases       Phase[]
}

// ===== v3.10: Giai đoạn dự án (Discovery → Design → Dev → QA → Launch) =====
model Phase {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id])
  name      String
  order     Int     @default(0)
  color     String?
}

// ===== v3.10: Lịch sử thay đổi công việc =====
model TaskEvent {
  id       String   @id @default(cuid())
  taskId   String
  userId   String?
  userName String
  text     String
  at       DateTime @default(now())
}

// ===== v3.10: Mẫu dự án — nhân bản bộ task/mốc/phase chuẩn =====
// phases: JSON [{name, tasks:[{title, estHours, priority, offsetDays}]}]
// milestones: JSON [{name, offsetDays}]
model ProjectTemplate {
  id          String   @id @default(cuid())
  name        String
  service     String?
  budgetHours Int      @default(0)
  phases      String   @default("[]")
  milestones  String   @default("[]")
  createdAt   DateTime @default(now())
}

model Task {
  id         String   @id @default(cuid())
  title      String
  projectId  String?
  project    Project? @relation(fields: [projectId], references: [id])
  assigneeId String?
  assignee   User?    @relation(fields: [assigneeId], references: [id])
  priority   String   @default("medium")
  status     String   @default("todo")
  dueDate    String?
  note       String?
  dependsOn  String   @default("[]") // v3.2: JSON [taskId] — việc phải xong trước mới được hoàn thành
  checklist  String   @default("[]") // v3.7: JSON [{text, done}] — các bước con trong việc
  recur      String? // v3.7: weekly | monthly — xong tự tạo kỳ sau
  estHours   Float    @default(0) // v3.10: giờ ước lượng — so với giờ đã log
  phaseId    String? // v3.10: thuộc giai đoạn nào của dự án
  labels     String   @default("[]") // v3.10: JSON nhãn phân loại
  statusSince String? // v3.12: YYYY-MM-DD vào cột hiện tại từ khi nào — tính tuổi việc
}

// ===== v3.8: Đánh giá hiệu suất theo quý =====
// scores: JSON [{name, self, mgr}] — điểm 1-5 theo tiêu chí
model Review {
  id        String   @id @default(cuid())
  userId    String
  quarter   String // VD: 2026-Q3
  scores    String   @default("[]")
  selfNote  String?
  mgrNote   String?
  status    String   @default("pending") // pending (chờ tự chấm) | self_done | final
  createdAt DateTime @default(now())

  @@unique([userId, quarter])
}

// ===== v3.7: Bình luận trao đổi trên công việc =====
model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  userId    String
  content   String
  createdAt DateTime @default(now())
}

// ===== v3.2: Mốc dự án hiển thị trên Gantt =====
model Milestone {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id])
  name      String
  date      String // YYYY-MM-DD
  done      Boolean @default(false)
  note      String?
}

model TimeLog {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id])
  projectId String
  project   Project @relation(fields: [projectId], references: [id])
  taskId    String? // v3.12: gắn giờ vào công việc cụ thể → ước lượng vs thực tế
  date      String
  hours     Float   @default(0)
  billable  Boolean @default(true)
  note      String?
}

// ===== v3.12: Công nợ thanh toán freelancer theo job =====
model Payout {
  id        String   @id @default(cuid())
  userId    String // freelancer
  projectId String?
  kind      String   @default("hourly") // hourly (giờ×đơn giá) | fixed (khoán)
  hours     Float    @default(0) // nếu hourly
  amount    Int      @default(0)
  status    String   @default("pending") // pending | paid
  note      String?
  createdAt DateTime @default(now())
  paidDate  String?
}

model Quote {
  id       String  @id @default(cuid())
  code     String  @unique
  clientId String
  client   Client  @relation(fields: [clientId], references: [id])
  items    String  @default("[]") // JSON [{desc, qty, price}]
  vat      Int     @default(8)
  status   String  @default("draft")
  date     String
  note     String?
}

model Invoice {
  id        String  @id @default(cuid())
  code      String  @unique
  clientId  String
  client    Client  @relation(fields: [clientId], references: [id])
  projectId String?
  items     String  @default("[]")
  vat       Int     @default(8)
  status    String  @default("draft")
  date      String
  dueDate   String?
  paidDate  String?
  payments  String  @default("[]") // JSON [{id, amount, date, note}]
  recurring Boolean @default(false)
  recGroup  String?
}

model Transaction {
  id          String  @id @default(cuid())
  type        String // income | expense
  category    String?
  amount      Int     @default(0)
  date        String
  desc        String?
  projectId   String?
  createdById String?
}

model Leave {
  id     String  @id @default(cuid())
  userId String
  user   User    @relation(fields: [userId], references: [id])
  from   String
  to     String
  type   String  @default("annual")
  status String  @default("pending")
  note   String?
}

// ===== CRM: nhật ký hoạt động / lịch hẹn =====
model Activity {
  id      String  @id @default(cuid())
  kind    String  @default("note") // call | meeting | email | note
  refType String // client | lead
  refId   String
  title   String
  date    String?
  done    Boolean @default(false)
  userId  String?
  note    String?
}

// ===== Mua hàng: nhà cung cấp + hóa đơn đầu vào (AP) =====
model Vendor {
  id      String       @id @default(cuid())
  name    String
  type    String? // KOL, Freelancer, Nhà in, Studio, Media…
  contact String?
  phone   String?
  email   String?
  note    String?
  rating  Int          @default(0) // 0-5
  bills   VendorBill[]
}

model VendorBill {
  id        String  @id @default(cuid())
  code      String
  vendorId  String
  vendor    Vendor  @relation(fields: [vendorId], references: [id])
  projectId String?
  desc      String?
  amount    Int     @default(0)
  date      String
  dueDate   String?
  status    String  @default("pending") // pending | approved | paid
  paidDate  String?
}

// ===== Hợp đồng =====
model Contract {
  id        String  @id @default(cuid())
  code      String
  type      String  @default("client") // client | vendor | labor
  partner   String // tên đối tác (khách / NCC / nhân sự)
  value     Int     @default(0)
  signDate  String?
  startDate String?
  endDate   String?
  status    String  @default("active") // active | expired | terminated
  note      String?
}

// ===== Tài sản & công cụ =====
model Asset {
  id       String  @id @default(cuid())
  name     String
  category String? // Thiết bị quay, Laptop, License phần mềm…
  serial   String?
  holderId String? // ai đang giữ
  price    Int     @default(0)
  buyDate  String?
  renewAt  String? // ngày gia hạn license (nếu có)
  status   String  @default("in_use") // in_use | storage | broken | sold
  note     String?
}

model Team {
  id     String  @id @default(cuid())
  name   String
  leadId String? // Trưởng nhóm
}

// ===== Máy phê duyệt đa bước =====
// steps: JSON [{role, userId?, userName?, status: pending|approved|rejected, at?, note?}]
// payload: JSON dữ liệu chờ thực thi khi duyệt xong (VD: khoản chi chưa ghi sổ)
model Approval {
  id            String    @id @default(cuid())
  type          String // quote | expense | leave | vendorbill
  refId         String?
  title         String
  amount        Int       @default(0)
  payload       String?
  requesterId   String
  requesterName String
  steps         String    @default("[]")
  status        String    @default("pending") // pending | approved | rejected
  createdAt     DateTime  @default(now())
  decidedAt     DateTime?
}

// ===== v2.2 HRM =====
model Attendance {
  id       String  @id @default(cuid())
  userId   String
  date     String
  status   String  @default("present") // present | remote | off
  checkIn  String? // v3.11: HH:MM giờ vào ca
  checkOut String? // v3.11: HH:MM giờ tan ca
  otHours  Float   @default(0) // v3.11: giờ làm thêm
  note     String?

  @@unique([userId, date])
}

model Candidate {
  id        String  @id @default(cuid())
  name      String
  position  String
  email     String?
  phone     String?
  source    String?
  stage     String  @default("applied") // applied | interview1 | interview2 | offer | hired | rejected
  note      String?
  createdAt String?
}

// Bảng lương tháng: lines = JSON [{userId, name, base, allowance, bonus, insurance, tax, net, employerCost}]
model Payroll {
  id        String   @id @default(cuid())
  month     String   @unique // YYYY-MM
  status    String   @default("draft") // draft | final
  lines     String   @default("[]")
  createdAt DateTime @default(now())
}

// ===== v2.3 Tài chính nâng cao =====
model Budget {
  id       String @id @default(cuid())
  month    String // YYYY-MM
  category String
  amount   Int    @default(0)

  @@unique([month, category])
}

// ===== v2.4 Customer Success: ticket hỗ trợ + SLA =====
model Ticket {
  id         String    @id @default(cuid())
  code       String
  clientId   String?
  title      String
  desc       String?
  priority   String    @default("normal") // urgent | high | normal | low
  status     String    @default("open") // open | in_progress | waiting | resolved | closed
  assigneeId String?
  channel    String? // email | phone | zalo | messenger | meeting
  createdAt  DateTime  @default(now())
  dueAt      DateTime? // hạn SLA
  resolvedAt DateTime?
}

// ===== v2.5: KPI/OKR theo quý + khảo sát NPS =====
model Okr {
  id      String  @id @default(cuid())
  quarter String // VD: 2026-Q3
  userId  String? // null = OKR công ty
  title   String
  target  Float   @default(100)
  current Float   @default(0)
  unit    String? // %, khách, triệu đ…
  note    String?
}

model NpsResponse {
  id       String  @id @default(cuid())
  clientId String?
  score    Int // 0-10
  date     String
  comment  String?
}

// ===== v3.1: Nhắn tin nội bộ =====
model Conversation {
  id        String       @id @default(cuid())
  type      String       @default("dm") // dm | group | general (kênh chung cả công ty)
  name      String?
  createdAt DateTime     @default(now())
  members   ConvMember[]
  messages  Message[]
}

model ConvMember {
  id         String       @id @default(cuid())
  convId     String
  conv       Conversation @relation(fields: [convId], references: [id])
  userId     String
  lastReadAt DateTime     @default(now())

  @@unique([convId, userId])
}

model Message {
  id        String       @id @default(cuid())
  convId    String
  conv      Conversation @relation(fields: [convId], references: [id])
  senderId  String
  content   String
  createdAt DateTime     @default(now())
}

// ===== v3.2: Hoa hồng sales =====
model Commission {
  id        String  @id @default(cuid())
  userId    String // AM được hưởng hoa hồng
  invoiceId String // hóa đơn nguồn gốc
  clientId  String?
  rate      Float   @default(0) // % hoa hồng (VD: 5.0)
  amount    Int     @default(0) // VND = grand(invoice) × rate/100
  month     String // YYYY-MM tháng tính hoa hồng
  status    String  @default("pending") // pending | paid
  note      String?
  createdAt String?
}

// ===== v3.3: API mở — key hoạt động như "user ảo" với vai trò riêng =====
model ApiKey {
  id        String    @id @default(cuid())
  name      String
  prefix    String // 10 ký tự đầu của key để nhận diện trong danh sách
  keyHash   String    @unique // sha256(key) — key thô chỉ hiển thị 1 lần lúc tạo
  roles     String    @default("[\"PM\"]") // quyền của key, dùng chung RBAC registry
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  lastUsed  DateTime?
}

// ===== v3.3: Webhook — bắn sự kiện ra ngoài (n8n/Zapier/hệ thống khác) =====
model Webhook {
  id         String   @id @default(cuid())
  url        String
  events     String   @default("[\"*\"]") // JSON ["leads.update","invoices.*","*"]
  secret     String? // HMAC-SHA256 ký payload → header X-Signature
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  lastStatus String? // kết quả lần gọi gần nhất: "200" / "lỗi: …"
}

// ===== v3.3: Rule tự động IF/THEN =====
// conditions: JSON [{field, op, value}] — AND với nhau; op: = != > < >= <= contains changed
// actions: JSON [{type: 'chat'|'task'|'webhook', ...params}] — template {field} lấy từ bản ghi
model Rule {
  id         String   @id @default(cuid())
  name       String
  active     Boolean  @default(true)
  resource   String // leads, invoices, tasks, tickets…
  event      String   @default("update") // create | update | any
  conditions String   @default("[]")
  actions    String   @default("[]")
  createdAt  DateTime @default(now())
}

// ===== v3.3: CSAT theo ticket (1-5 sao) =====
model CsatResponse {
  id       String  @id @default(cuid())
  ticketId String?
  clientId String?
  score    Int // 1-5
  date     String
  comment  String?
}

// ===== v3.5: Thông báo trong app (chuông) =====
model Notification {
  id        String    @id @default(cuid())
  userId    String // người nhận
  text      String
  route     String? // trang đích khi click, VD: /approvals
  readAt    DateTime?
  createdAt DateTime  @default(now())
}

// ===== v3.5: Gắn link tài liệu ngoài (Drive/Notion/Figma…) =====
model DocLink {
  id        String   @id @default(cuid())
  refType   String // project | client | contract
  refId     String
  title     String
  url       String
  addedBy   String?
  createdAt DateTime @default(now())
}

// ===== v3.5: RFQ so giá nhà cung cấp cho một hạng mục =====
// quotes: JSON [{vendorId, price, note, chosen}]
model Rfq {
  id        String   @id @default(cuid())
  title     String
  status    String   @default("open") // open | decided
  quotes    String   @default("[]")
  note      String?
  createdAt DateTime @default(now())
}

// ===== v3.5: Checklist onboarding nhân sự mới =====
// items: JSON [{text, done}]
model Onboarding {
  id          String   @id @default(cuid())
  name        String // tên nhân sự mới
  candidateId String?
  position    String?
  startDate   String?
  items       String   @default("[]")
  status      String   @default("active") // active | done
  createdAt   DateTime @default(now())
}

model Setting {
  id   Int    @id @default(1)
  json String @default("{}")
}

model AuditLog {
  id       String   @id @default(cuid())
  userId   String
  userName String
  action   String // create | update | delete | approve | login | import
  entity   String
  refId    String?
  detail   String?
  at       DateTime @default(now())
}
