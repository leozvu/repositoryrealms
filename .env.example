# Prisma schema dùng PostgreSQL cho cả development và production.
# DATABASE_URL: pooler/runtime (Supabase/Neon thường dùng cổng 6543).
# DIRECT_URL: kết nối trực tiếp dùng cho Prisma CLI/migration (thường là cổng 5432).
DATABASE_URL="postgresql://user:pass@localhost:5432/crmegoric_dev?schema=public"
DIRECT_URL="postgresql://user:pass@localhost:5432/crmegoric_dev?schema=public"

# Chuỗi bí mật ngẫu nhiên dài (bắt buộc) — tạo: openssl rand -hex 32
NEXTAUTH_SECRET="thay-bang-chuoi-ngau-nhien-dai"
# URL công khai của app; production bắt buộc HTTPS.
NEXTAUTH_URL="http://localhost:3300"

# (Tùy chọn) AI Copilot — hoặc nhập trong Cài đặt của app
# ANTHROPIC_API_KEY="sk-ant-..."

# CRMegoric Realms ↔ ERP — khóa mặc định.
# Chỉ bật đồng thời trên development/staging sau khi schema Realm đã được review và deploy.
# REALM_ERP_SYNC_ENABLED="1"
# NEXT_PUBLIC_REALM_ERP_SYNC="1"

# Phase 12 staging gate — intentionally separate from DATABASE_URL/DIRECT_URL.
# The CLI never falls back to the app database and blocks public/prod-like targets.
# REALM_DEPLOY_ENV="staging"
# REALM_STAGING_DATABASE_URL="postgresql://user:pass@db-stage:5432/erp_stage?schema=realm_stage"

# Full ERP/CRM + Realms clone. Must point to a separate disposable staging database.
# REALMS_DEPLOY_ENV="staging"
# REALMS_STAGING_DATABASE_URL="postgresql://user:pass@db-stage:5432/erp_stage?schema=public"
# REALMS_STAGING_APPROVAL="generated-by-npm-run-staging-plan"
# REALMS_STAGING_ALLOW_UNMARKED_TARGET="0"
# REALMS_STAGING_RESET_CONFIRM="RESET_REALMS_FULL_STAGING_WITH_DEMO_DATA"
# REALMS_STAGING_DEMO_PASSWORD="store-in-a-password-manager"
# Existing db-push staging only: REALMS_STAGING_MIGRATION_CONFIRM="BASELINE_EXISTING_REALMS_STAGING_SCHEMA"
# Migration deploy only: REALMS_STAGING_MIGRATION_CONFIRM="DEPLOY_REALMS_STAGING_MIGRATIONS"
# REALM_STAGING_SCHEMA="realm_stage"
# REALM_STAGING_APPROVAL="realm-phase12:db-stage:5432:erp_stage:realm_stage"
# Rollback only: REALM_STAGING_ROLLBACK_CONFIRM="DROP_REALM_PHASE12_STAGING_DATA"
