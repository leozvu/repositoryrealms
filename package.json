{
  "name": "agency-erp",
  "version": "3.27.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3300",
    "build": "prisma generate && next build",
    "start": "next start -p 3300",
    "db:push": "prisma db push",
    "db:seed": "node prisma/seed.js",
    "migration:ci": "prisma migrate deploy && prisma migrate diff --from-schema-datasource prisma/schema.prisma --to-schema-datamodel prisma/schema.prisma --exit-code",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-lines=90 --test-coverage-functions=85 --test-coverage-branches=75 \"tests/**/*.test.mjs\"",
    "test:e2e": "playwright test",
    "audit:ui:inventory": "node scripts/audit-ui-inventory.mjs",
    "audit:ui:check": "node scripts/audit-ui-inventory.mjs --check",
    "audit:ui:actions": "node scripts/audit-ui-actions.mjs",
    "audit:ui:actions:check": "node scripts/audit-ui-actions.mjs --check",
    "audit:ui:interactions": "node scripts/audit-ui-interactions.mjs",
    "audit:ui:interactions:check": "node scripts/audit-ui-interactions.mjs --check",
    "audit:realm:bridge": "node scripts/audit-realm-erp-bridge.mjs",
    "audit:realm:bridge:check": "node scripts/audit-realm-erp-bridge.mjs --check",
    "audit:realm:access": "node scripts/audit-realm-access.mjs",
    "audit:realm:access:check": "node scripts/audit-realm-access.mjs --check",
    "audit:realm:sync": "node scripts/audit-realm-sync.mjs",
    "audit:realm:sync:check": "node scripts/audit-realm-sync.mjs --check",
    "audit:realm:observability": "node scripts/audit-realm-observability.mjs",
    "audit:realm:observability:check": "node scripts/audit-realm-observability.mjs --check",
    "audit:realm:changes": "node scripts/audit-realm-change-feed.mjs",
    "audit:realm:changes:check": "node scripts/audit-realm-change-feed.mjs --check",
    "audit:realm:cross-surface": "node scripts/audit-realm-cross-surface.mjs",
    "audit:realm:cross-surface:check": "node scripts/audit-realm-cross-surface.mjs --check",
    "audit:realm:commands": "node scripts/audit-realm-command-bridge.mjs",
    "audit:realm:commands:check": "node scripts/audit-realm-command-bridge.mjs --check",
    "audit:realm:action-center": "node scripts/audit-realm-action-center.mjs",
    "audit:realm:action-center:check": "node scripts/audit-realm-action-center.mjs --check",
    "audit:realm:inbox": "node scripts/audit-realm-unified-inbox.mjs",
    "audit:realm:inbox:check": "node scripts/audit-realm-unified-inbox.mjs --check",
    "audit:realm:command-center": "node scripts/audit-realm-command-center.mjs",
    "audit:realm:command-center:check": "node scripts/audit-realm-command-center.mjs --check",
    "audit:realm:chronicle": "node scripts/audit-realm-chronicle.mjs",
    "audit:realm:chronicle:check": "node scripts/audit-realm-chronicle.mjs --check",
    "audit:realm:pilot": "node scripts/audit-realm-pilot.mjs",
    "audit:realm:pilot:check": "node scripts/audit-realm-pilot.mjs --check",
    "audit:realm:feedback": "node scripts/audit-realm-feedback.mjs",
    "audit:realm:feedback:check": "node scripts/audit-realm-feedback.mjs --check",
    "audit:collaboration": "node scripts/audit-collaboration-bridge.mjs",
    "audit:collaboration:check": "node scripts/audit-collaboration-bridge.mjs --check",
    "config:check": "node scripts/validate-runtime-env.mjs",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "qa": "npm run config:check && npm run audit:ui:check && npm run audit:ui:actions:check && npm run audit:ui:interactions:check && npm run audit:realm:bridge:check && npm run audit:realm:access:check && npm run audit:realm:sync:check && npm run audit:realm:observability:check && npm run audit:realm:changes:check && npm run audit:realm:cross-surface:check && npm run audit:realm:commands:check && npm run audit:realm:action-center:check && npm run audit:realm:inbox:check && npm run audit:realm:command-center:check && npm run audit:realm:chronicle:check && npm run audit:realm:pilot:check && npm run audit:realm:feedback:check && npm run audit:collaboration:check && npm run test:coverage && npm run audit:prod && npm run build",
    "qa:full": "npm run qa && npm run test:e2e",
    "realm:signal": "node scripts/realm-signal-server.mjs",
    "realm:media:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-realm-livekit.ps1",
    "realm:media:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-realm-livekit.ps1",
    "realm:media:doctor": "node scripts/realm-media-doctor.mjs",
    "realm:staging:plan": "node scripts/realm-staging-gate.mjs plan",
    "realm:staging:apply": "node scripts/realm-staging-gate.mjs apply",
    "realm:staging:verify": "node scripts/realm-staging-gate.mjs verify",
    "realm:staging:rollback": "node scripts/realm-staging-gate.mjs rollback",
    "staging:plan": "node scripts/full-staging-gate.mjs plan",
    "staging:provision": "node scripts/full-staging-gate.mjs provision",
    "staging:verify": "node scripts/full-staging-gate.mjs verify",
    "staging:migrations:plan": "node scripts/staging-migration-gate.mjs plan",
    "staging:migrations:baseline": "node scripts/staging-migration-gate.mjs baseline",
    "staging:migrations:deploy": "node scripts/staging-migration-gate.mjs deploy",
    "staging:migrations:verify": "node scripts/staging-migration-gate.mjs verify",
    "backup": "node scripts/backup-db.js",
    "restore": "node scripts/restore-db.js"
  },
  "dependencies": {
    "@prisma/client": "^5.17.0",
    "bcryptjs": "^2.4.3",
    "livekit-client": "^2.20.1",
    "livekit-server-sdk": "^2.17.0",
    "next": "15.5.20",
    "next-auth": "^4.24.7",
    "nodemailer": "9.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "8.21.0"
  },
  "devDependencies": {
    "@babel/parser": "^7.29.7",
    "@playwright/test": "1.61.1",
    "prisma": "^5.17.0"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.10"
    },
    "next-auth": {
      "nodemailer": "9.0.3",
      "uuid": "11.1.1"
    }
  }
}
